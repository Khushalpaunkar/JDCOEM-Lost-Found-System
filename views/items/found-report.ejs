<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Report an item found in response to a JDCOEM Lost report.">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/report.css">
  <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <%- include('../includes/navbar') %>

  <main class="report-page">
    <div class="report-container">
      <header class="report-intro">
        <div class="report-intro-copy">
          <p class="report-eyebrow"><span aria-hidden="true"></span> JDCOEM CAMPUS COMMUNITY</p>
          <h1><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i> I FOUND THIS ITEM</h1>
          <p class="report-intro-text">Share where and when you found it. This report will be sent to the Lost report owner for follow-up; it does not verify ownership or recovery.</p>
        </div>
        <figure class="report-campus-visual">
          <img src="/asset/images/jdgateimage.jpg" alt="A covered walkway on the JDCOEM campus">
          <figcaption>
            <span class="report-visual-label">JDCOEM COMMUNITY</span>
            <strong>Help a campus belonging find its way home.</strong>
          </figcaption>
        </figure>
      </header>

      <section class="report-section" aria-labelledby="lost-report-heading">
        <h2 class="report-section-heading" id="lost-report-heading"><span class="report-step">LOST REPORT</span> <%= lostItem.title %></h2>
        <p class="report-section-description"><%= lostItem.category %> · <%= lostItem.location %></p>
        <p class="report-section-description"><%= lostItem.description %></p>
      </section>

      <% if (error) { %>
        <p class="report-server-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> <%= error %></p>
      <% } %>

      <% if (success) { %>
        <div class="report-server-error" role="status">
          Your Found report was saved. An email notification was attempted separately, but delivery may not be confirmed. The Lost report remains unchanged until recovery is verified.
        </div>
        <a class="report-cancel" href="/items/<%= lostItem._id %>">Back to Lost report</a>
      <% } else if (existingReport) { %>
        <div class="report-server-error" role="status">You have already submitted a Found report for this Lost report.</div>
        <a class="report-cancel" href="/items/<%= lostItem._id %>">Back to Lost report</a>
      <% } else { %>
        <form class="report-form" data-report-status="found" action="/items/<%= lostItem._id %>/report-found" method="POST" enctype="multipart/form-data" novalidate>
          <section class="report-section" aria-labelledby="found-details-heading">
            <h2 class="report-section-heading" id="found-details-heading"><span class="report-step">01</span> Found item details</h2>
            <p class="report-section-description">Describe the item you found, where it is now, and when you found it.</p>
            <div class="report-fields-grid">
              <div class="report-field report-field-full">
                <label for="report-location">Found location <span class="report-required">*</span></label>
                <input id="report-location" name="location" type="text" maxlength="200" placeholder="e.g. Central Library, second floor" required autocomplete="off">
              </div>

              <div class="report-field">
                <label for="report-date">Date found</label>
                <input id="report-date" name="date" type="date">
              </div>

              <div class="report-field">
                <label for="report-time">Approximate time found</label>
                <input id="report-time" name="time" type="time">
              </div>

              <div class="report-field report-field-full">
                <label for="report-description">Description <span class="report-required">*</span></label>
                <textarea id="report-description" name="description" rows="5" minlength="10" maxlength="2000" placeholder="Describe its condition and any details that can help the owner identify it." required></textarea>
                <small class="report-field-hint">Do not include private claim or ownership-proof details.</small>
              </div>
            </div>
          </section>

          <section class="report-section report-upload-section" aria-labelledby="report-upload-heading">
            <h2 class="report-section-heading" id="report-upload-heading"><span class="report-step">02</span> Add photos <span class="report-optional">Optional</span></h2>
            <p class="report-section-description">Photos are attached only to this Found report, not to the Lost item.</p>
            <div class="report-upload" id="report-upload">
              <input class="report-upload-input" id="report-images" name="image" type="file" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple aria-describedby="upload-guidance upload-message">
              <label class="report-upload-prompt" for="report-images" tabindex="0">
                <span class="report-upload-icon" aria-hidden="true"><i class="fa-solid fa-arrow-up-from-bracket"></i></span>
                <span class="report-upload-title">Choose images <span>or drag them here</span></span>
                <span class="report-upload-meta" id="upload-guidance">JPEG, PNG or WebP · Up to 5 images · 5 MB each</span>
              </label>
              <p class="report-upload-empty" id="upload-empty">No images selected</p>
              <ul class="report-upload-list" id="upload-list" aria-label="Selected image previews"></ul>
            </div>
            <p class="report-upload-message" id="upload-message" role="status" aria-live="polite">Selected images will be uploaded with your Found report.</p>
          </section>

          <div class="report-form-bottom">
            <div class="report-form-actions">
              <a class="report-cancel" href="/items/<%= lostItem._id %>">Back to Lost report</a>
              <button class="report-submit" type="submit">
                <span id="report-submit-label">Submit Found Report</span>
                <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
              </button>
            </div>
          </div>
          <p class="report-validation-message" id="report-validation-message" role="alert" aria-live="assertive"></p>
        </form>
      <% } %>

      <dialog class="report-lightbox" id="report-lightbox" aria-labelledby="report-lightbox-caption">
        <button class="report-lightbox-close" id="report-lightbox-close" type="button" aria-label="Close image preview">
          <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <img class="report-lightbox-image" id="report-lightbox-image" alt="">
        <p class="report-lightbox-caption" id="report-lightbox-caption"></p>
      </dialog>
    </div>
  </main>

  <%- include('../includes/footer') %>
  <script src="/js/report.js" defer></script>
</body>
</html>
