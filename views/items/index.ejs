
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Items | SmartRecover</title>
  <link rel="stylesheet" href="/css/items.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>

  <%- include('../includes/navbar') %>

  <main class="items-page">

    <!-- Hero -->
    <section class="items-hero">
      <div class="hero-content">
        <span class="eyebrow"><i class="fa-solid fa-magnifying-glass"></i> CAMPUS LOST & FOUND</span>
        <h1>Every item has a <span>story.</span><br>Let's reunite it.</h1>
        <p>Browse reported items across JDCOEM and help belongings find their way home.</p>

        <a href="/report" class="hero-btn">
          <i class="fa-solid fa-plus"></i> Report an Item
        </a>
      </div>

      <div class="hero-visual">
        <div class="hero-icon"><i class="fa-solid fa-box-open"></i></div>
        <div class="floating-card floating-top">
          <i class="fa-solid fa-circle-check"></i>
          <span>One campus, one community</span>
        </div>
        <div class="floating-card floating-bottom">
          <i class="fa-solid fa-heart"></i>
          <span>Helping items find their owners</span>
        </div>
      </div>
    </section>

    <!-- Search and filters -->
    <section class="sr-search-section" id="find-item">
    <div class="sr-container">

      <div class="sr-search-panel">
        <div class="sr-search-heading">
          <div>
            <span class="section-kicker">QUICK SEARCH</span>
            <h2>Find an item</h2>
            <p>Search by keyword, report type, category, or location.</p>
          </div>

          <div class="sr-search-heading-icon">
            <i class="fa-solid fa-sliders"></i>
          </div>
        </div>

        <form action="/items" method="GET" class="sr-search-form">
          <div class="sr-search-field sr-search-keyword">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input
              type="search"
              name="search"
              value="<%= selectedSearch %>"
              placeholder="Search wallet, phone, backpack..."
              aria-label="Search for an item"
              maxlength="100"
            />
          </div>

          <div class="sr-search-field">
            <i class="fa-solid fa-layer-group"></i>
            <select name="category" aria-label="Select item category">
              <option value="">All Categories</option>
              <% categories.forEach(function(category) { %>
                <option value="<%= category %>" <%= selectedCategory === category ? 'selected' : '' %>>
                  <%= category %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="sr-search-field">
            <i class="fa-solid fa-circle-exclamation"></i>
            <select name="status" aria-label="Select report type">
              <option value="">Lost &amp; Found</option>
              <option value="lost" <%= selectedStatus === 'lost' ? 'selected' : '' %>>Lost items</option>
              <option value="found" <%= selectedStatus === 'found' ? 'selected' : '' %>>Found items</option>
            </select>
          </div>

          <div class="sr-search-field">
            <i class="fa-solid fa-location-dot"></i>
            <select name="location" aria-label="Select campus location">
              <option value="">All Locations</option>
              <% locations.forEach(function(location) { %>
                <option value="<%= location %>" <%= selectedLocation === location ? 'selected' : '' %>>
                  <%= location %>
                </option>
              <% }) %>
            </select>
          </div>

          <button type="submit" class="sr-search-button">
            <i class="fa-solid fa-magnifying-glass"></i>
            Apply filters
          </button>
        </form>

        <% if (selectedSearch || selectedStatus || selectedCategory || selectedLocation) { %>
          <a href="/items" class="sr-clear-filters">
            <i class="fa-solid fa-xmark"></i> Clear filters
          </a>
        <% } %>
      </div>
    </div>
  </section>


    <section class="browse-section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">THE CAMPUS COLLECTION</span>
          <h2>Browse reported items</h2>
          <p>Find something lost or help someone recover what matters.</p>
        </div>
      </div>


<div class="results-row">
  <p><strong><%= items.length %></strong> <%= items.length === 1 ? 'report' : 'reports' %> found</p>
  <span><i class="fa-solid fa-shield-halved"></i> Campus community</span>
</div>

<div class="sr-items-grid" id="itemsGrid">

    <% if (items && items.length > 0) { %>
  <% items.forEach(item => {
    const firstImage = Array.isArray(item.image)
      ? item.image[0]
      : item.image;

    const reportDate = item.date || item.createdAt;

    const formattedDate = reportDate
      ? new Date(reportDate).toLocaleDateString("en-IN", {
          day: "2-digit",
          month: "short",
          year: "numeric"
        })
      : "";

    const formattedTime = item.time || (
      reportDate
        ? new Date(reportDate).toLocaleTimeString("en-IN", {
            hour: "2-digit",
            minute: "2-digit",
            hour12: true
          })
        : ""
    );
  %>

      <article class="sr-item-card"
        data-type="<%= item.status %>"
        data-category="<%= item.category %>"
        data-search="<%= [item.title, item.description, item.category, item.location].join(' ').toLowerCase() %>">

        <div class="item-image">
          <span class="item-badge <%= item.status === 'lost' ? 'lost-badge' : 'found-badge' %>">
            <i class="fa-solid <%= item.status === 'lost' ? 'fa-circle-exclamation' : 'fa-circle-check' %>"></i>
            <%= item.status === 'lost' ? 'Lost' : 'Found' %>
          </span>

          <% if (firstImage) { %>
            <img
              src="<%= firstImage %>"
              alt="<%= item.title %>"
              loading="lazy"
              onerror="this.style.display='none'; this.nextElementSibling.hidden=false;">
            <div class="image-fallback" hidden>
              <i class="fa-regular fa-image"></i>
              <span>Image unavailable</span>
            </div>
          <% } else { %>
            <div class="image-fallback">
              <i class="fa-regular fa-image"></i>
              <span>No image available</span>
            </div>
          <% } %>
        </div>

        <div class="item-info">
          <div class="item-category"><%= item.category %></div>

          <h3><%= item.title %></h3>

          <p class="item-description"><%= item.description %></p>

          <div class="item-location">
            <i class="fa-solid fa-location-dot"></i>
            <span><%= item.location %></span>
          </div>

          <div class="item-date">
            <i class="fa-regular fa-calendar"></i>
            <span><%= formattedDate %><%= formattedTime ? ' · ' + formattedTime : '' %></span>
          </div>

          <div class="item-footer">
            <span class="status-text">
              <i class="fa-regular fa-clock"></i>
              <%= item.recoveryStatus === 'recovered' || item.recoveryStatus === 'closed'
                ? 'Closed'
                : item.status === 'lost' ? 'Awaiting recovery' : 'Awaiting owner' %>
            </span>

            <a href="/items/<%= item._id %>" class="details-btn">
              View Details <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        </div>
      </article>

    <% }); %>
  <% } else { %>
    <div class="empty-state">
      <i class="fa-solid fa-box-open"></i>
      <h3><%= selectedSearch || selectedStatus || selectedCategory || selectedLocation
        ? 'No matching items'
        : 'No items found yet' %></h3>
      <p><%= selectedSearch || selectedStatus || selectedCategory || selectedLocation
        ? 'Try changing your search or filters.'
        : 'New lost and found reports will appear here.' %></p>
      <% if (selectedSearch || selectedStatus || selectedCategory || selectedLocation) { %>
        <a href="/items" class="hero-btn">Clear filters</a>
      <% } else { %>
        <a href="/report" class="hero-btn">Report an Item</a>
      <% } %>
    </div>
  <% } %>
</div>

    </section>

    <!-- CTA -->
    <section class="report-cta">
      <div class="cta-icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
      <div class="cta-copy">
        <h2>Found something on campus?</h2>
        <p>Your small action could make someone's day. Report it and help return it to its owner.</p>
      </div>
      <a href="/report" class="cta-btn">Report an Item <i class="fa-solid fa-arrow-right"></i></a>
    </section>

  </main>

  <%- include('../includes/footer') %>

</body>
</html>
