<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password — Lost & Found JDCOEM</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/login.css">
  <link rel="stylesheet" href="/css/auth-reset.css">
</head>
<body>
  <% if (error) { %>
  <p class="alert-error" role="alert"><%= error %></p>
<% } %>

<% if (success) { %>
  <p class="alert-success" role="status"><%= success %></p>
<% } %>

<div class="auth-page">
  <div class="auth-bg"></div>

  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
        </svg>
      </div>
      Lost<span class="accent">&</span>Found
    </div>

    <h2 class="auth-title">Forgot Password?</h2>
    <p class="auth-sub">Enter your registered email address to receive a password reset link</p>

    <form action="/forgot-password" method="POST">
      <div class="form-group">
        <label>Email Address <span>*</span></label>
        <input type="email" name="email" class="form-control" placeholder="your@email.com" required autofocus>
      </div>

      <button type="submit" class="submit-btn">
        Send Reset Link
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </button>
    </form>

    <p class="auth-switch">Remember your password? <a href="/login">Back to Login</a></p>
  </div>
</div>
</body>
</html>
