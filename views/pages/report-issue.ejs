<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/home.css">
  <link rel="stylesheet" href="/css/navbar.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/report-issue.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
</head>
<body>
  <%- include('../includes/navbar') %>

  <main class="issue-page">
    <div class="issue-card">

      <a href="/support" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Support
      </a>

      <span class="eyebrow"><i class="fa-solid fa-bug"></i> REPORT AN ISSUE</span>
      <h1>Tell us what went wrong</h1>
      <p class="intro">
        Something not working as expected? Describe the problem here and the campus team
        will look into it. Your report is recorded with your account so we can follow up.
        For common questions, check the <a href="/faq">FAQ</a> first.
      </p>

      <% if (submitted) { %>
        <div class="success-message" role="status">
          <i class="fa-solid fa-circle-check"></i>
          <strong>Your issue has been recorded.</strong>
          <% if (reference) { %>
            Your reference is <strong><%= reference %></strong>.
          <% } %>
          The support team will review it. If you need to add details, submit another report
          or email <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.
        </div>

        <div class="issue-success-actions">
          <a href="/support" class="submit-btn issue-inline-btn">
            <i class="fa-solid fa-life-ring"></i> Back to Support
          </a>
          <a href="/faq" class="issue-secondary-btn">
            <i class="fa-regular fa-circle-question"></i> Browse FAQ
          </a>
        </div>
      <% } else { %>

        <% if (error) { %>
          <div class="error-message" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <%= error %>
          </div>
        <% } %>

        <form action="/report-issue" method="POST" novalidate>
          <div class="form-group">
            <label for="issue-category">Issue category <span class="required-mark">*</span></label>
            <select id="issue-category" name="category" required aria-describedby="issue-category-help">
              <option value="" <%= !values.category ? 'selected' : '' %> disabled>Choose a category</option>
              <option value="login_account" <%= values.category === 'login_account' ? 'selected' : '' %>>Login/Account</option>
              <option value="report_submission" <%= values.category === 'report_submission' ? 'selected' : '' %>>Report Submission</option>
              <option value="claim_submission" <%= values.category === 'claim_submission' ? 'selected' : '' %>>Claim Submission</option>
              <option value="image_upload" <%= values.category === 'image_upload' ? 'selected' : '' %>>Image Upload</option>
              <option value="email_notification" <%= values.category === 'email_notification' ? 'selected' : '' %>>Email Notification</option>
              <option value="ui_display" <%= values.category === 'ui_display' ? 'selected' : '' %>>UI/Display</option>
              <option value="other" <%= values.category === 'other' ? 'selected' : '' %>>Other</option>
            </select>
            <small id="issue-category-help">Pick the area that best matches the problem.</small>
          </div>

          <div class="form-group">
            <label for="issue-subject">Subject <span class="required-mark">*</span></label>
            <input
              type="text"
              id="issue-subject"
              name="subject"
              required
              minlength="5"
              maxlength="150"
              value="<%= values.subject || '' %>"
              placeholder="Short summary, e.g. Claim form shows an error"
              aria-describedby="issue-subject-help"
            >
            <small id="issue-subject-help">5 to 150 characters.</small>
          </div>

          <div class="form-group">
            <label for="issue-description">Detailed description <span class="required-mark">*</span></label>
            <textarea
              id="issue-description"
              name="description"
              required
              minlength="20"
              maxlength="4000"
              placeholder="What happened? What did you expect instead? Mention the steps you took."
              aria-describedby="issue-description-help"
            ><%= values.description || '' %></textarea>
            <small id="issue-description-help">At least 20 characters. Avoid pasting passwords or other secrets.</small>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="issue-page">Affected page or route <span class="optional-mark">(optional)</span></label>
              <input
                type="text"
                id="issue-page"
                name="page"
                maxlength="300"
                value="<%= values.page || '' %>"
                placeholder="e.g. /items or /profile"
                aria-describedby="issue-page-help"
              >
              <small id="issue-page-help">Where the problem happened.</small>
            </div>

            <div class="form-group">
              <label for="issue-error-message">Error message <span class="optional-mark">(optional)</span></label>
              <input
                type="text"
                id="issue-error-message"
                name="errorMessage"
                maxlength="1000"
                value="<%= values.errorMessage || '' %>"
                placeholder="Exact text shown on screen, if any"
                aria-describedby="issue-error-help"
              >
              <small id="issue-error-help">Copy the message exactly if you saw one.</small>
            </div>
          </div>

          <button type="submit" class="submit-btn">
            <i class="fa-solid fa-paper-plane"></i> Submit issue report
          </button>

          <p class="privacy-note">
            <i class="fa-solid fa-lock"></i>
            Submitted from your account (<%= currentUser.name %>). Your details are used only
            to handle this report — see the <a href="/privacy-policy">Privacy Policy</a>.
            Contact: <a href="mailto:<%= supportEmail %>"><%= supportEmail %></a>
          </p>
        </form>

      <% } %>

    </div>
  </main>

  <%- include('../includes/footer') %>
</body>
</html>
