<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Learn how SmartRecover helps the JDCOEM community report lost belongings, share found-item information, and take thoughtful steps toward recovery.">
  <meta name="theme-color" content="#071720">
  <title>About Us | SmartRecover</title>
  <link rel="stylesheet" href="/css/about.css">
  <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
  <div class="about-page">
    <%- include('../includes/navbar') %>

    <main id="main-content">
      <!-- 1. Hero -->
      <section class="sr-hero" aria-labelledby="hero-title">
        <div class="sr-hero__glow sr-hero__glow--one" aria-hidden="true"></div>
        <div class="sr-hero__glow sr-hero__glow--two" aria-hidden="true"></div>
        <div class="sr-hero__grid" aria-hidden="true"></div>
        <div class="sr-hero__inner sr-shell">
          <div class="sr-hero__copy" data-reveal>
            <p class="sr-eyebrow sr-eyebrow--light"><span class="sr-eyebrow__spark" aria-hidden="true"></span> Lost &amp; Found · JDCOEM</p>
            <h1 id="hero-title">Every lost item<br><em>deserves a way home.</em></h1>
            <p class="sr-hero__intro">SmartRecover helps the JDCOEM community report lost belongings, share found-item information, explore available reports, and take the next step toward reuniting items with their rightful owners.</p>
            <div class="sr-hero__actions">
              <!-- Default placeholder: update /report-lost to the application's verified lost-item route. -->
              <a class="sr-button sr-button--lime" href="/report-lost">Report an item <span aria-hidden="true">↗</span></a>
              <a class="sr-button sr-button--glass" href="/items">Browse items <span aria-hidden="true">→</span></a>
            </div>
            <div class="sr-hero__note"><span class="sr-hero__note-dot" aria-hidden="true"></span> A more connected way to look out for one another</div>
          </div>

          <div class="sr-hero-art" role="img" aria-label="Illustration of a lost notebook being found through connected campus reports" data-reveal>
            <div class="sr-hero-art__orbit sr-hero-art__orbit--outer" aria-hidden="true"></div>
            <div class="sr-hero-art__orbit sr-hero-art__orbit--inner" aria-hidden="true"></div>
            <span class="sr-hero-art__dot sr-hero-art__dot--a" aria-hidden="true"></span>
            <span class="sr-hero-art__dot sr-hero-art__dot--b" aria-hidden="true"></span>
            <div class="sr-found-card">
              <div class="sr-found-card__top"><span class="sr-found-card__tag"><i aria-hidden="true"></i> CAMPUS REPORT</span><span class="sr-found-card__more" aria-hidden="true">•••</span></div>
              <div class="sr-notebook" aria-hidden="true"><span class="sr-notebook__spine"></span><span class="sr-notebook__line sr-notebook__line--one"></span><span class="sr-notebook__line sr-notebook__line--two"></span><span class="sr-notebook__line sr-notebook__line--three"></span><span class="sr-notebook__mark">S</span></div>
              <div class="sr-found-card__title">Something familiar?</div>
              <div class="sr-found-card__description">A notebook report with details that may help its owner recognize it.</div>
              <div class="sr-found-card__bottom"><span class="sr-found-card__avatar" aria-hidden="true">JD</span><span>Shared with the campus community</span><span class="sr-found-card__arrow" aria-hidden="true">↗</span></div>
            </div>
            <div class="sr-float-chip sr-float-chip--pin"><span aria-hidden="true">⌖</span> Campus-wide</div>
            <div class="sr-float-chip sr-float-chip--match"><span aria-hidden="true">✳</span> A clue can connect</div>
            <svg class="sr-hero-art__path" viewBox="0 0 500 430" fill="none" aria-hidden="true"><path d="M45 300C120 300 111 113 214 113s72 191 156 191c39 0 54-35 87-35" stroke="url(#path-gradient)" stroke-width="1.5" stroke-dasharray="5 8"/><circle cx="45" cy="300" r="5" fill="#B9EB76"/><circle cx="457" cy="269" r="5" fill="#B9EB76"/><defs><linearGradient id="path-gradient" x1="44" y1="113" x2="457" y2="304" gradientUnits="userSpaceOnUse"><stop stop-color="#B9EB76" stop-opacity=".12"/><stop offset=".55" stop-color="#B9EB76"/><stop offset="1" stop-color="#63D1C2" stop-opacity=".25"/></linearGradient></defs></svg>
            <p class="sr-hero-art__caption"><span aria-hidden="true">✳</span> Every detail helps make a connection.</p>
          </div>
          <a class="sr-hero__scroll" href="#mission"><span class="sr-hero__scroll-line" aria-hidden="true"></span> Discover the story</a>
        </div>
        <div class="sr-hero__bottomline" aria-hidden="true"></div>
      </section>

      <!-- 2. Mission -->
      <section class="sr-mission sr-section" id="mission" aria-labelledby="mission-title">
        <div class="sr-shell sr-mission__layout">
          <div class="sr-mission__lead" data-reveal>
            <p class="sr-eyebrow"><span>01</span> THE REASON WE'RE HERE</p>
            <h2 id="mission-title">Making lost-and-found <span>simple, connected,</span> and accessible.</h2>
            <p class="sr-mission__closing">A small act of sharing can make a big difference to someone else's day.</p>
          </div>
          <div class="sr-mission__body" data-reveal>
            <p class="sr-mission__opening">A lost ID card, a misplaced notebook, a set of keys left behind. Losing something on campus is stressful. Finding an item without knowing its owner can be just as uncertain.</p>
            <p>When updates depend on scattered notices or word of mouth, useful details are easy to miss. SmartRecover was created to give JDCOEM students a more organized place to explore relevant reports and use the application's reporting and claim workflows.</p>
            <p>Our aim is to make reporting more convenient, encourage responsible next steps, and help the campus community look out for one another.</p>
            <div class="sr-mission__signature"><span class="sr-mission__signature-mark" aria-hidden="true">↗</span><span>Less searching alone.<br><strong>More finding together.</strong></span></div>
          </div>
          <div class="sr-mission-visual" aria-hidden="true" data-reveal>
            <div class="sr-mission-visual__grain"></div>
            <div class="sr-mission-visual__label">A CAMPUS, CONNECTED</div>
            <div class="sr-mission-visual__map">
              <svg viewBox="0 0 450 270" fill="none"><path d="M35 214C83 214 71 82 160 82c64 0 67 118 130 118 52 0 47-82 126-82" stroke="#7FCBB8" stroke-width="2" stroke-dasharray="5 7"/><path d="M68 50h75v46H68zM275 49h97v57h-97zM179 160h80v44h-80zM330 164h62v39h-62z" stroke="#D5E8D8" stroke-opacity=".45"/><circle cx="35" cy="214" r="8" fill="#C6EE81"/><circle cx="416" cy="118" r="8" fill="#C6EE81"/><circle cx="160" cy="82" r="5" fill="#7FCBB8"/><circle cx="290" cy="200" r="5" fill="#7FCBB8"/></svg>
              <span class="sr-mission-visual__pin sr-mission-visual__pin--one">LOST</span><span class="sr-mission-visual__pin sr-mission-visual__pin--two">FOUND</span>
            </div>
            <div class="sr-mission-visual__bottom"><span>One shared place to start</span><span aria-hidden="true">✳</span></div>
          </div>
        </div>
      </section>

      <!-- 3. How it works -->
      <section class="sr-how sr-section" aria-labelledby="how-title">
        <div class="sr-shell">
          <div class="sr-section-heading sr-section-heading--center" data-reveal>
            <p class="sr-eyebrow"><span>02</span> A CLEARER PATH FORWARD</p>
            <h2 id="how-title">From lost to found,<br><span>one step at a time.</span></h2>
            <p>Three thoughtful steps help students move from a report toward a possible reunion.</p>
          </div>
          <div class="sr-steps">
            <article class="sr-step" data-reveal>
              <div class="sr-step__top"><span class="sr-step__number">01</span><span class="sr-step__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 7v21m0 0 8-8m-8 8-8-8M10 29v9a3 3 0 0 0 3 3h22a3 3 0 0 0 3-3v-9"/></svg></span></div>
              <h3>Report an item</h3>
              <p>When something goes missing, submit a lost-item report with relevant details. If you find an item, use the dedicated found-item reporting workflow to share what you discovered.</p>
              <span class="sr-step__foot">Two distinct ways to help</span>
            </article>
            <div class="sr-steps__connector" aria-hidden="true"><span>→</span></div>
            <article class="sr-step sr-step--featured" data-reveal>
              <div class="sr-step__top"><span class="sr-step__number">02</span><span class="sr-step__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="21" cy="21" r="12"/><path d="m30 30 10 10M16 21h10m-5-5v10"/></svg></span></div>
              <h3>Discover and connect</h3>
              <p>Explore the reports available in the app and review useful item details. If something looks familiar, follow the supported claim process for the next steps.</p>
              <span class="sr-step__foot">Look closely. Follow up responsibly.</span>
            </article>
            <div class="sr-steps__connector" aria-hidden="true"><span>→</span></div>
            <article class="sr-step" data-reveal>
              <div class="sr-step__top"><span class="sr-step__number">03</span><span class="sr-step__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M8 25.5 19 36 40 13M12 12h13M12 19h7"/></svg></span></div>
              <h3>Work toward recovery</h3>
              <p>Use the available claim and communication process to coordinate a return, with appropriate ownership checks along the way. Email updates may support relevant steps where implemented.</p>
              <span class="sr-step__foot">A claim begins a conversation</span>
            </article>
          </div>
          <p class="sr-how__note"><span aria-hidden="true">✳</span> A claim can help start the process; it does not by itself confirm ownership or guarantee recovery.</p>
        </div>
      </section>

      <!-- 4. Values -->
      <section class="sr-values sr-section" aria-labelledby="values-title">
        <div class="sr-shell">
          <div class="sr-values__heading" data-reveal>
            <div><p class="sr-eyebrow"><span>03</span> WHAT GUIDES THE EXPERIENCE</p><h2 id="values-title">The principles<br>behind <span>SmartRecover.</span></h2></div>
            <p>Useful technology starts with people. These are the ideas we want every interaction to reflect.</p>
          </div>
          <div class="sr-values__grid">
            <article class="sr-value sr-value--trust" data-reveal><span class="sr-value__index">A / 01</span><div class="sr-value__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M24 5 39 11v11c0 10-6.2 16.7-15 21-8.8-4.3-15-11-15-21V11L24 5Z"/><path d="m17 24 5 5 10-11"/></svg></div><h3>Trust &amp; responsibility</h3><p>Honest reports, responsible claims, and thoughtful care help make recovery a better experience for everyone.</p><span class="sr-value__accent" aria-hidden="true"></span></article>
            <article class="sr-value sr-value--privacy" data-reveal><span class="sr-value__index">A / 02</span><div class="sr-value__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><rect x="10" y="21" width="28" height="21" rx="4"/><path d="M16 21v-6a8 8 0 0 1 16 0v6m-8 9v4"/></svg></div><h3>Privacy &amp; care</h3><p>Student information deserves respect. Share only what is needed and handle personal details responsibly.</p><span class="sr-value__accent" aria-hidden="true"></span></article>
            <article class="sr-value sr-value--community" data-reveal><span class="sr-value__index">A / 03</span><div class="sr-value__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><circle cx="18" cy="16" r="6"/><circle cx="33" cy="19" r="5"/><path d="M6 39v-4a12 12 0 0 1 24 0v4H6Zm24-11a10 10 0 0 1 12 10v1H34"/></svg></div><h3>Community support</h3><p>A little attention from a fellow student can be the clue that helps a belonging find its way back.</p><span class="sr-value__accent" aria-hidden="true"></span></article>
            <article class="sr-value sr-value--simple" data-reveal><span class="sr-value__index">A / 04</span><div class="sr-value__icon" aria-hidden="true"><svg viewBox="0 0 48 48"><path d="M9 12h30M9 24h20M9 36h13"/><circle cx="35" cy="24" r="4"/><circle cx="28" cy="36" r="4"/><circle cx="16" cy="12" r="4"/></svg></div><h3>Simple &amp; accessible</h3><p>Reporting and exploring should feel clear, so students can focus on the details that matter.</p><span class="sr-value__accent" aria-hidden="true"></span></article>
          </div>
        </div>
      </section>

      <!-- 5. JDCOEM community -->
      <section class="sr-community sr-section" aria-labelledby="community-title">
        <div class="sr-community__wash" aria-hidden="true"></div>
        <div class="sr-shell sr-community__layout">
          <div class="sr-community__copy" data-reveal>
            <p class="sr-eyebrow sr-eyebrow--light"><span>04</span> MADE FOR OUR CAMPUS</p>
            <h2 id="community-title">Built for the<br><em>JDCOEM community.</em></h2>
            <p>SmartRecover is designed for students of JD College of Engineering and Management, Nagpur. It brings lost-and-found information into a shared campus experience and makes it easier to take a responsible first step.</p>
            <p>When we pay attention, report thoughtfully, and help one another, small campus moments can turn into meaningful connections.</p>
            <div class="sr-community__mantra"><span class="sr-community__mantra-icon" aria-hidden="true">✳</span><span>One campus. One community.<br><strong>A better way to recover.</strong></span></div>
          </div>
          <div class="sr-community-art" role="img" aria-label="Abstract illustration of students and campus paths connecting around a shared lost-and-found point" data-reveal>
            <div class="sr-community-art__skyline" aria-hidden="true"><span class="sr-building sr-building--a"><i></i><i></i><i></i></span><span class="sr-building sr-building--b"><i></i><i></i><i></i><i></i></span><span class="sr-building sr-building--c"><i></i><i></i></span><span class="sr-community-art__tree sr-community-art__tree--a"></span><span class="sr-community-art__tree sr-community-art__tree--b"></span></div>
            <svg class="sr-community-art__routes" viewBox="0 0 520 430" fill="none" aria-hidden="true"><path d="M44 307c58 0 53-103 134-103 70 0 73 99 147 99 72 0 63-145 145-145" stroke="#B9E77A" stroke-width="2" stroke-dasharray="5 8"/><path d="M63 142c57 0 71 88 133 88s76-104 145-104" stroke="#6AD0BC" stroke-width="1.5" stroke-dasharray="4 9"/><circle cx="44" cy="307" r="7" fill="#C7EF80"/><circle cx="470" cy="158" r="7" fill="#C7EF80"/><circle cx="341" cy="126" r="5" fill="#6AD0BC"/></svg>
            <div class="sr-community-art__center"><span class="sr-community-art__center-icon" aria-hidden="true">⌖</span><span>JDCOEM<br><small>CONNECTED BY CARE</small></span></div>
            <span class="sr-community-art__person sr-community-art__person--one" aria-hidden="true">A</span><span class="sr-community-art__person sr-community-art__person--two" aria-hidden="true">R</span><span class="sr-community-art__person sr-community-art__person--three" aria-hidden="true">S</span>
            <div class="sr-community-art__caption"><span class="sr-community-art__caption-mark" aria-hidden="true">✳</span> Better together, on campus.</div>
          </div>
        </div>
      </section>

      <!-- 6. Developer -->
      <section class="sr-developer sr-section" aria-labelledby="developer-title">
        <div class="sr-shell">
          <div class="sr-developer__heading" data-reveal><p class="sr-eyebrow"><span>05</span> THE PERSON BEHIND THE PROJECT</p><h2 id="developer-title">Meet the <span>developer.</span></h2></div>
          <div class="sr-developer__card" data-reveal>
            <div class="sr-developer__identity">
              <div class="sr-developer__portrait" role="img" aria-label="Initials avatar for developer Khushal Paunkar"><span>KP</span><i aria-hidden="true"></i><b aria-hidden="true"></b><small>STUDENT DEVELOPER</small></div>
              <div class="sr-developer__name"><h3>Khushal Paunkar</h3><p>Student Developer <span>·</span> Aspiring Full-Stack Developer</p></div>
              <div class="sr-developer__facts"><div><span>EDUCATION</span><strong>B.Tech — Computer Science<br>and Engineering</strong></div><div><span>COLLEGE</span><strong>JD College of Engineering<br>and Management, Nagpur</strong></div></div>
            </div>
            <div class="sr-developer__story">
              <span class="sr-developer__quote" aria-hidden="true">“</span>
              <p>Hi, I'm Khushal Paunkar, a Computer Science and Engineering student at JD College of Engineering and Management, Nagpur. I enjoy building practical web applications that solve real-world problems. SmartRecover is one of my academic projects, developed to make the campus lost-and-found process more organized and accessible. Through this project, I aim to apply my web development skills to create useful solutions for the college community.</p>
              <p class="sr-developer__motivation">A student project exploring how thoughtful web development can address a practical campus problem.</p>
              <div class="sr-tech"><span class="sr-tech__label">BUILT WITH</span><div class="sr-tech__tags"><span>Node.js</span><span>Express.js</span><span>EJS</span><span>MongoDB Atlas</span><span>CSS</span><span>Cloudinary</span></div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- 7. Final CTA -->
      <section class="sr-cta" aria-labelledby="cta-title">
        <div class="sr-cta__orb sr-cta__orb--one" aria-hidden="true"></div><div class="sr-cta__orb sr-cta__orb--two" aria-hidden="true"></div>
        <div class="sr-shell sr-cta__inner" data-reveal>
          <p class="sr-eyebrow sr-eyebrow--light"><span>YOUR NEXT STEP</span></p>
          <h2 id="cta-title">Let's help every lost item<br><em>find its way home.</em></h2>
          <p>Whether you've lost something or discovered an item on campus, taking the right first step can help someone reconnect with their belongings.</p>
          <div class="sr-cta__actions">
            <!-- Default placeholder: update /report-lost to the application's verified lost-item route. -->
            <a class="sr-button sr-button--lime" href="/report-lost">Report an item <span aria-hidden="true">↗</span></a>
            <a class="sr-button sr-button--outline" href="/items">Browse items <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="sr-cta__rings" aria-hidden="true"><span></span><span></span><span></span></div>
      </section>
    </main>

    <%- include('../includes/footer') %>
  </div>

  <script>
    // Content starts visible. Add reveal behavior only when IntersectionObserver is available.
    (() => {
      const items = document.querySelectorAll('.about-page [data-reveal]');
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      items.forEach((item) => item.classList.add('sr-reveal-ready'));
      const observer = new IntersectionObserver((entries, activeObserver) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('sr-is-visible');
            activeObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.14, rootMargin: '0px 0px -35px 0px' });
      items.forEach((item) => observer.observe(item));
    })();
  </script>
</body>
</html>
